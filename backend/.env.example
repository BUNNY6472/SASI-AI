# Copy to backend/.env for local development. Never commit real keys.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional model pins (empty = pick automatically from each provider's model list)
CLAUDE_MODEL=claude-opus-5-5
GEMINI_MODEL=
# Google Cloud Vertex AI: Claude, Gemini and open models with no API keys (needs Google credentials)
VERTEX_AI=false
GCP_PROJECT=
OPEN_MODELS=glm,deepseek,qwen,kimi
TEAM_SIZE=4
# Time is a run's limit; the last minutes are for delivering the complete result. 0 caps = no cap.
RUN_TIME_LIMIT_MINUTES=60
WRAP_UP_MINUTES=5
MAX_MODEL_CALLS_PER_RUN=0
MAX_TOKENS_PER_RUN=0
# Access code for the web app (empty = no gate, local only)
APP_ACCESS_CODE=
SESSION_SECRET=change-me
STORAGE_BACKEND=memory
