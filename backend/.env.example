# Copy to backend/.env for local development. Never commit real keys.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional model pins (empty = pick automatically from each provider's model list)
CLAUDE_MODEL=claude-opus-5-5
GEMINI_MODEL=
# Google Cloud Vertex AI: Gemini and open models use the runtime service account.
# Claude uses the separate API key above unless explicitly opted into Vertex.
VERTEX_AI=false
VERTEX_CLAUDE_ENABLED=false
# Production uses true: Vertex Gemini is allowed; partner models and Gemini keys are blocked.
TRIAL_CREDITS_ONLY=false
# Separate owner-funded Claude opt-in. Uses only this new key slot, never ANTHROPIC_API_KEY.
# Production stores this key in Secret Manager through the authenticated Connections page.
ALLOW_CLAUDE_API_KEY=false
SASI_OWNER_ANTHROPIC_API_KEY=
GCP_PROJECT=
OPEN_MODELS=glm,deepseek,qwen,kimi,minimax,gptoss
TEAM_SIZE=4
# Research target, not a hard wall-clock cutoff. Completed work proceeds immediately.
RUN_TIME_LIMIT_MINUTES=120
MAX_TOTAL_RUN_MINUTES=120
# Legacy strict-run reserve; new runs use the per-call minimum and grace below.
WRAP_UP_MINUTES=5
MODEL_PHASE_MIN_MINUTES=20
MODEL_PHASE_GRACE_MINUTES=5
# Active calls and one final synthesis may extend beyond the target, within the 120-minute total cap.
# 0 token/call caps = no cap; the total time cap always applies.
MAX_MODEL_CALLS_PER_RUN=300
MAX_TOKENS_PER_RUN=2400000
ERIS_MAX_TOKENS_PER_RUN=3600000
ENABLE_WEB_RESEARCH=true
RESEARCH_TIMEOUT_SECONDS=45
# Access code for the web app (empty = no gate, local only)
APP_ACCESS_CODE=
REQUIRE_ACCESS_TOKEN=false
SESSION_SECRET=change-me
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/sasi.db
